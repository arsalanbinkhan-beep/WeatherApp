<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Card style -->
    <style name="Widget.WeatherApp.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">#1E293B</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">#334155</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Text styles -->
    <style name="TextAppearance.WeatherApp.Headline" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">96sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <style name="TextAppearance.WeatherApp.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">#94A3B8</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>